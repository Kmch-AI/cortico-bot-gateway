{
  // 浏览器端面板:带 DOM 类型。@types/node 只用于类型检查——面板 import type 的
  // client-panel.ts 会链到 core/types.ts 与 providers/pricebook.ts,后者引用 node:crypto。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["webui/**/*.ts", "capabilities.ts"],
  "exclude": ["node_modules", "dist"]
}
