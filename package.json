{
  "name": "@kmchai/cortico-bot-gateway",
  "version": "0.1.0",
  "type": "module",
  "description": "Cortico bot: Kmch AI gateway persona that declares voice, service and QQ capabilities",
  "author": "kmchai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kmch-AI/cortico-bot-gateway.git"
  },
  "keywords": [
    "cortico-bot",
    "cortico",
    "gateway",
    "voice",
    "qq",
    "网关",
    "语音",
    "人设"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./index.ts",
  "cortico": {
    "kind": "bot",
    "api": 7,
    "displayName": "Kmch AI · 网关",
    "locales": {
      "zh": {
        "displayName": "Kmch AI · 网关",
        "description": "Kmch AI 的 bot 层:人设、情绪、记忆(后续),声明并协调语音、服务与 QQ 能力。"
      },
      "en": {
        "displayName": "Kmch AI · Gateway",
        "description": "The bot layer of Kmch AI: persona, emotion and memory (later), declaring and coordinating voice, service and QQ capabilities."
      }
    },
    "tags": [
      "im",
      "qq",
      "voice",
      "external-setup",
      "experimental"
    ],
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": [
    "index.ts",
    "capabilities.ts",
    "persona",
    "dist/webui.js",
    "dist/webui.css",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "build:webui": "node scripts/build-webui.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
