{
  // 只有 Node 侧代码,lib 里不放 DOM。Persona 页面板在 webui/ 下,由 tsconfig.web.json 检查。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["index.ts", "capabilities.ts", "persona/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
